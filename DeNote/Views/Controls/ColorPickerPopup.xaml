<UserControl
    x:Class="DeNote.Views.Controls.ColorPickerPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeNote.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="150"
    d:DesignWidth="150"
    mc:Ignorable="d">
    <Grid>
        <Popup
            x:Name="ColorPopup"
            AllowsTransparency="True"
            HorizontalOffset="{Binding HorizontalOffset, ElementName=Root}"
            IsOpen="{Binding IsOpen, ElementName=Root}"
            Placement="{Binding Placement, ElementName=Root}"
            PlacementTarget="{Binding PlacementTarget, ElementName=Root}"
            PopupAnimation="Fade"
            StaysOpen="False"
            VerticalOffset="{Binding VerticalOffset, ElementName=Root}">

            <Border
                Padding="5"
                Background="#50443F"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="3">

                <ItemsControl ItemsSource="{Binding ColorPreset}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="13" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="1"
                                BorderThickness="0"
                                Click="ColorButton_Click"
                                Cursor="Hand"
                                ToolTip="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border BorderBrush="#E0E0E0" BorderThickness="1">
                                            <Rectangle Width="12" Height="12">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding}" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="Black" />
                                                <Setter Property="BorderThickness" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>
</UserControl>
