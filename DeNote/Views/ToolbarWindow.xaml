<Window x:Class="DeNote.Views.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeNote.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
        mc:Ignorable="d"
        Closing="Window_Closing"
        Title="ToolbarWindow">
    <Grid>
        <StackPanel>
            <ui:Button Content="펜" HorizontalAlignment="Stretch" Margin="10"/>
            <ui:Button Content="형광펜" HorizontalAlignment="Stretch" Margin="10"/>
            <ui:Button Content="도형" HorizontalAlignment="Stretch" Margin="10"/>
        </StackPanel>
        <tray:NotifyIcon>
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="Exit" Click="NotifyIcon_Exit" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</Window>
