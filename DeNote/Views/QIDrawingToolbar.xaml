<UserControl
    x:Class="DeNote.Views.QIDrawingToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeNote.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignWidth="800" d:DesignHeight="100"
    mc:Ignorable="d">
    <Grid>
        <Popup
            x:Name="ToolbarPopup"
            Placement="MousePoint"
            AllowsTransparency="True"
            StaysOpen="False"
            IsOpen="False">
            <Border
                x:Name="ToolbarContainer"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="10"
                Background="#50443F"
                BorderBrush="#AAFFFFFF"
                BorderThickness="0.2"
                CornerRadius="16"
                Opacity="0.9">
                <StackPanel Margin="0" Orientation="Horizontal">
                    <StackPanel x:Name="DrawingToolPanel" Orientation="Horizontal">
                        <ui:Button
                            x:Name="PenBtn"
                            Margin="8"
                            Padding="5"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="PenBtn_Click"
                            CornerRadius="30"
                            Foreground="#C0FFFFFF"
                            MouseOverBackground="Orange">
                            <!--  Pen  -->
                            <TextBlock
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="✏️"
                                TextAlignment="Center" />
                        </ui:Button>
                        <ui:Button
                            x:Name="HighlighterBtn"
                            Margin="4,8"
                            Padding="5"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="HighlighterBtn_Click"
                            CornerRadius="30"
                            Foreground="#C0FFFFFF"
                            MouseOverBackground="Orange">
                            <!--  Pen  -->
                            <TextBlock
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="🖍️"
                                TextAlignment="Center" />
                        </ui:Button>
                        <ui:Button
                            x:Name="ShapeBtn"
                            Margin="4,8"
                            Padding="5"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="ShapeBtn_Click"
                            CornerRadius="30"
                            Foreground="#C0FFFFFF"
                            MouseOverBackground="Orange">
                            <TextBlock
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="🔶"
                                TextAlignment="Center" />
                        </ui:Button>
                        <ui:Button
                            x:Name="EraserBtn"
                            Margin="4,8"
                            Padding="5"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="EraserBtn_Click"
                            CornerRadius="30"
                            Foreground="#C0FFFFFF"
                            MouseOverBackground="Orange">
                            <TextBlock
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="❇️"
                                TextAlignment="Center" />
                        </ui:Button>
                    </StackPanel>
                    <Separator Opacity="0.5" />
                    <ui:Button
                        x:Name="ThicknessBtn"
                            Margin="4,8"
                            Padding="5"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="ThicknessBtn_Click"
                        CornerRadius="30"
                        Foreground="#C0FFFFFF"
                        MouseOverBackground="Orange">
                        <TextBlock
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="✒️"
                            TextAlignment="Center" />
                    </ui:Button>
                    <ui:Button
                        x:Name="ColorPickerBtn"
                            Margin="4,8"
                            Padding="5"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="ColorPickerBtn_Click"
                        CornerRadius="30"
                        MouseOverBackground="Orange">
                        <Ellipse
                            x:Name="ColorPreviewCircle"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stroke="#C0FFFFFF" />
                    </ui:Button>
                    <Separator Opacity="0.5" />
                    <ui:Button
                        x:Name="CloseBtn"
                            Margin="8"
                            Padding="5"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="CloseBtn_Click"
                        CornerRadius="30"
                        Foreground="#C0FFFFFF"
                        MouseOverBackground="Orange">
                        <TextBlock
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="❌"
                            TextAlignment="Center" />
                    </ui:Button>
                </StackPanel>
            </Border>
        </Popup>


        <Popup
            x:Name="ShapePickerPopup"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=ShapeBtn}"
            StaysOpen="False">
            <Border
                Padding="10"
                Background="White"
                BorderBrush="Black"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Text="옵션" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox
                            x:Name="FillOptionCheckBox"
                            Margin="5"
                            Checked="FillOptionCheckBox_Checked"
                            Content="채우기"
                            Unchecked="FillOptionCheckBox_Checked" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontWeight="Bold"
                        Text="도형 선택" />
                    <!--  도형 선택 버튼들  -->
                    <StackPanel x:Name="ShapesPanel" Orientation="Horizontal">
                        <Button
                            x:Name="RectangleBtn"
                            Margin="5"
                            Click="ShapeTypeBtn_Click"
                            Content="사각형"
                            Tag="Rectangle" />
                        <Button
                            x:Name="EllipseBtn"
                            Margin="5"
                            Click="ShapeTypeBtn_Click"
                            Content="원"
                            Tag="Ellipse" />
                        <Button
                            x:Name="TriangleBtn"
                            Margin="5"
                            Click="ShapeTypeBtn_Click"
                            Content="삼각형"
                            Tag="Triangle" />
                        <Button
                            x:Name="LineBtn"
                            Margin="5"
                            Click="ShapeTypeBtn_Click"
                            Content="선"
                            Tag="Line" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup
            x:Name="ThicknessPopup"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=ThicknessBtn}"
            StaysOpen="False">
            <Border
                Padding="10"
                Background="White"
                BorderBrush="Black"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Text="두께"
                        TextAlignment="Center" />
                    <StackPanel Orientation="Vertical">
                        <Slider
                            x:Name="ThicknessSlider"
                            Margin="5"
                            HorizontalAlignment="Center"
                            IsSnapToTickEnabled="True"
                            Maximum="20"
                            Minimum="1"
                            Orientation="Vertical"
                            TickFrequency="1"
                            ValueChanged="ThicknessSlider_ValueChanged" />
                        <TextBlock
                            x:Name="ThicknessValueText"
                            Width="40"
                            HorizontalAlignment="Center"
                            Text="{Binding ElementName=ThicknessSlider, Path=Value, StringFormat={}{0}}"
                            TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup
            x:Name="ColorPickerPopup"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=ColorPickerBtn}"
            StaysOpen="False">
            <Border
                Padding="10"
                Background="White"
                BorderBrush="Black"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Text="색상 선택" />
                    <UniformGrid Columns="4">
                        <Button
                            x:Name="RedBtn"
                            Margin="5"
                            Background="Red"
                            Click="ColorBtn_Click"
                            Tag="Red" />
                        <Button
                            x:Name="GreenBtn"
                            Margin="5"
                            Background="Green"
                            Click="ColorBtn_Click"
                            Tag="Green" />
                        <Button
                            x:Name="BlueBtn"
                            Margin="5"
                            Background="Blue"
                            Click="ColorBtn_Click"
                            Tag="Blue" />
                        <Button
                            x:Name="YellowBtn"
                            Margin="5"
                            Background="Yellow"
                            Click="ColorBtn_Click"
                            Tag="Yellow" />
                        <Button
                            x:Name="CyanBtn"
                            Margin="5"
                            Background="Cyan"
                            Click="ColorBtn_Click"
                            Tag="Cyan" />
                        <Button
                            x:Name="MagentaBtn"
                            Margin="5"
                            Background="Magenta"
                            Click="ColorBtn_Click"
                            Tag="Magenta" />
                        <Button
                            x:Name="BlackBtn"
                            Margin="5"
                            Background="Black"
                            Click="ColorBtn_Click"
                            Tag="Black" />
                        <Button
                            x:Name="WhiteBtn"
                            Margin="5"
                            Background="White"
                            Click="ColorBtn_Click"
                            Tag="White" />
                        <Button
                            x:Name="GrayBtn"
                            Margin="5"
                            Background="Gray"
                            Click="ColorBtn_Click"
                            Tag="Gray" />
                        <Button
                            x:Name="OrangeBtn"
                            Margin="5"
                            Background="Orange"
                            Click="ColorBtn_Click"
                            Tag="Orange" />
                        <Button
                            x:Name="PinkBtn"
                            Margin="5"
                            Background="Pink"
                            Click="ColorBtn_Click"
                            Tag="Pink" />
                        <Button
                            x:Name="PurpleBtn"
                            Margin="5"
                            Background="Purple"
                            Click="ColorBtn_Click"
                            Tag="Purple" />
                        <Button
                            x:Name="BrownBtn"
                            Margin="5"
                            Background="Brown"
                            Click="ColorBtn_Click"
                            Tag="Brown" />
                        <Button
                            x:Name="LimeBtn"
                            Margin="5"
                            Background="Lime"
                            Click="ColorBtn_Click"
                            Tag="Lime" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
