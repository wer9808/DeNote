<UserControl
    x:Class="DeNote.Views.QIDrawingToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DeNote.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeNote.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="100"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Popup
            x:Name="ToolbarPopup"
            AllowsTransparency="True"
            HorizontalOffset="-100"
            Placement="MousePoint"
            PopupAnimation="Fade"
            StaysOpen="False"
            VerticalOffset="-100">
            <Grid Width="200" Height="200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:Button
                    x:Name="DrawingToolPickerBtn"
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#50443F"
                    BorderBrush="#AAFFFFFF"
                    BorderThickness="0.2"
                    Click="DrawingToolPickerBtn_Click"
                    CornerRadius="30"
                    Foreground="#C0FFFFFF"
                    MouseOverBackground="Orange"
                    Opacity="0.9">
                    <!--  Pen  -->
                    <TextBlock
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        TextAlignment="Center" />
                </ui:Button>
                <ui:Button
                    x:Name="ThicknessBtn"
                    Grid.Row="1"
                    Grid.Column="2"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#50443F"
                    BorderBrush="#AAFFFFFF"
                    BorderThickness="0.2"
                    Click="ThicknessBtn_Click"
                    CornerRadius="30"
                    Foreground="#C0FFFFFF"
                    MouseOverBackground="Orange"
                    Opacity="0.9">
                    <TextBlock
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="T"
                        TextAlignment="Center" />
                </ui:Button>
                <ui:Button
                    x:Name="ShapeBtn"
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#50443F"
                    BorderBrush="#AAFFFFFF"
                    BorderThickness="0.2"
                    Click="ShapeBtn_Click"
                    CornerRadius="30"
                    Foreground="#C0FFFFFF"
                    MouseOverBackground="Orange"
                    Opacity="0.9">
                    <TextBlock
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="S"
                        TextAlignment="Center" />
                </ui:Button>

                <ui:Button
                    x:Name="ColorPickerBtn"
                    Grid.Row="2"
                    Grid.Column="1"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#50443F"
                    BorderBrush="#AAFFFFFF"
                    BorderThickness="0.2"
                    Click="ColorPickerBtn_Click"
                    CornerRadius="30"
                    MouseOverBackground="Orange"
                    Opacity="0.9">
                    <Ellipse
                        x:Name="ColorPreviewCircle"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="#C0FFFFFF" />
                </ui:Button>
                <ui:Button
                    x:Name="CloseBtn"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#50443F"
                    BorderBrush="#AAFFFFFF"
                    BorderThickness="0.2"
                    Click="CloseBtn_Click"
                    CornerRadius="50"
                    Foreground="#C0FFFFFF"
                    MouseOverBackground="Orange"
                    Opacity="0.9">
                    <TextBlock
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="❌"
                        TextAlignment="Center" />
                </ui:Button>
            </Grid>
        </Popup>


        <Popup
            x:Name="ShapePickerPopup"
            HorizontalOffset="-200"
            Placement="Center"
            PlacementTarget="{Binding ElementName=ShapeBtn}"
            StaysOpen="False"
            VerticalOffset="0">
            <Border
                Padding="10"
                Background="White"
                BorderBrush="Black"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Text="옵션" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox
                            x:Name="FillOptionCheckBox"
                            Margin="5"
                            Checked="FillOptionCheckBox_Checked"
                            Content="채우기"
                            Unchecked="FillOptionCheckBox_Checked" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontWeight="Bold"
                        Text="도형 선택" />
                    <!--  도형 선택 버튼들  -->
                    <StackPanel x:Name="ShapesPanel" Orientation="Horizontal">
                        <Button
                            x:Name="RectangleBtn"
                            Margin="5"
                            Click="ShapeTypeBtn_Click"
                            Content="사각형"
                            Tag="Rectangle" />
                        <Button
                            x:Name="EllipseBtn"
                            Margin="5"
                            Click="ShapeTypeBtn_Click"
                            Content="원"
                            Tag="Ellipse" />
                        <Button
                            x:Name="TriangleBtn"
                            Margin="5"
                            Click="ShapeTypeBtn_Click"
                            Content="삼각형"
                            Tag="Triangle" />
                        <Button
                            x:Name="LineBtn"
                            Margin="5"
                            Click="ShapeTypeBtn_Click"
                            Content="선"
                            Tag="Line" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup
            x:Name="ThicknessPopup"
            AllowsTransparency="True"
            HorizontalOffset="60"
            Placement="Center"
            PlacementTarget="{Binding ElementName=ThicknessBtn}"
            PopupAnimation="Fade"
            StaysOpen="False"
            VerticalOffset="0">
            <Border
                Padding="10"
                Background="White"
                BorderBrush="Black"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Text="두께"
                        TextAlignment="Center" />
                    <StackPanel Orientation="Vertical">
                        <Slider
                            x:Name="ThicknessSlider"
                            Margin="5"
                            HorizontalAlignment="Center"
                            IsSnapToTickEnabled="True"
                            Maximum="20"
                            Minimum="1"
                            Orientation="Vertical"
                            TickFrequency="1"
                            ValueChanged="ThicknessSlider_ValueChanged" />
                        <TextBlock
                            x:Name="ThicknessValueText"
                            Width="40"
                            HorizontalAlignment="Center"
                            Text="{Binding ElementName=ThicknessSlider, Path=Value, StringFormat={}{0}}"
                            TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <controls:ColorPickerPopup
            x:Name="ColorPickerPopup"
            HorizontalOffset="0"
            Placement="Center"
            PlacementTarget="{Binding ElementName=ColorPickerBtn}"
            SelectedColorChanged="ColorPickerPopup_SelectedColorChanged"
            VerticalOffset="120" />

        <controls:DrawingToolPickerPopup
            x:Name="DrawingToolPickerPopup"
            HorizontalOffset="0"
            Placement="Center"
            PlacementTarget="{Binding ElementName=DrawingToolPickerBtn}"
            SelectedToolChanged="DrawingToolPickerPopup_SelectedToolChanged"
            VerticalOffset="-60" />
    </Grid>
</UserControl>
