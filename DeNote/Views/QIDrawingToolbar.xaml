<UserControl
    x:Class="DeNote.Views.QIDrawingToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DeNote.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeNote.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="100"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Popup
            x:Name="ToolbarPopup"
            AllowsTransparency="True"
            HorizontalOffset="-100"
            Placement="MousePoint"
            PopupAnimation="Fade"
            StaysOpen="False"
            VerticalOffset="-100">
            <Grid Width="200" Height="200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:Button
                    x:Name="DrawingToolPickerBtn"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="2"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#50443F"
                    BorderBrush="#AAFFFFFF"
                    BorderThickness="0.2"
                    Click="DrawingToolPickerBtn_Click"
                    CornerRadius="30"
                    Foreground="#C0FFFFFF"
                    MouseOverBackground="Orange"
                    Opacity="0.9">
                    <!--  Pen  -->
                    <Image
                        x:Name="DrawingToolPickerBtnIcon"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect ShadowDepth="2" />
                        </Image.Effect>
                    </Image>
                    <Button.Effect>
                        <DropShadowEffect ShadowDepth="2" />
                    </Button.Effect>
                </ui:Button>
                <ui:Button
                    x:Name="ThicknessBtn"
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="2"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#50443F"
                    BorderBrush="#AAFFFFFF"
                    BorderThickness="0.2"
                    Click="ThicknessBtn_Click"
                    CornerRadius="30"
                    Foreground="#C0FFFFFF"
                    MouseOverBackground="Orange"
                    Opacity="0.9">
                    <Image
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="/Resources/icon_tools_thickness_white.png">
                        <Image.Effect>
                            <DropShadowEffect ShadowDepth="2" />
                        </Image.Effect>
                    </Image>
                    <Button.Effect>
                        <DropShadowEffect ShadowDepth="2" />
                    </Button.Effect>
                </ui:Button>
                <ui:Button
                    x:Name="ShapePickerBtn"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="2"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#50443F"
                    BorderBrush="#AAFFFFFF"
                    BorderThickness="0.2"
                    Click="ShapePickerBtn_Click"
                    CornerRadius="30"
                    Foreground="#C0FFFFFF"
                    MouseOverBackground="Orange"
                    Opacity="0.9">
                    <Image
                        x:Name="ShapePickerBtnIcon"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect ShadowDepth="2" />
                        </Image.Effect>
                    </Image>
                    <Button.Effect>
                        <DropShadowEffect ShadowDepth="2" />
                    </Button.Effect>
                </ui:Button>

                <ui:Button
                    x:Name="ColorPickerBtn"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="2"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#50443F"
                    BorderBrush="#AAFFFFFF"
                    BorderThickness="0.2"
                    Click="ColorPickerBtn_Click"
                    CornerRadius="30"
                    MouseOverBackground="Orange"
                    Opacity="0.9">
                    <Ellipse
                        x:Name="ColorPreviewCircle"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="#C0FFFFFF">
                        <Ellipse.Effect>
                            <DropShadowEffect ShadowDepth="2" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Button.Effect>
                        <DropShadowEffect ShadowDepth="2" />
                    </Button.Effect>
                </ui:Button>
                <ui:Button
                    x:Name="CloseBtn"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#50443F"
                    BorderBrush="#AAFFFFFF"
                    BorderThickness="0.2"
                    Click="CloseBtn_Click"
                    CornerRadius="50"
                    Foreground="#C0FFFFFF"
                    MouseOverBackground="Orange"
                    Opacity="0.9">
                    <TextBlock
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="❌"
                        TextAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="2" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <Button.Effect>
                        <DropShadowEffect ShadowDepth="2" />
                    </Button.Effect>
                </ui:Button>
            </Grid>
        </Popup>


        <Popup
            x:Name="ShapePickerPopup"
            AllowsTransparency="True"
            HorizontalOffset="-130"
            Placement="Center"
            PlacementTarget="{Binding ElementName=ShapePickerBtn}"
            PopupAnimation="Fade"
            StaysOpen="False"
            VerticalOffset="0">
            <Border
                Margin="5"
                Padding="10"
                Background="#50443F"
                BorderBrush="#AAFFFFFF"
                BorderThickness="0.2"
                CornerRadius="10"
                Opacity="0.9">

                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" />
                </Border.Effect>
                <StackPanel Margin="4">

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            FontSize="16"
                            Foreground="GhostWhite"
                            Text="도형" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="White"
                            Text="채우기" />
                        <Viewbox
                            Grid.Column="2"
                            Width="20"
                            Height="20"
                            Margin="0"
                            VerticalAlignment="Center">
                            <CheckBox
                                x:Name="FillOptionCheckBox"
                                Margin="0,3,-16,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="White"
                                Checked="FillOptionCheckBox_Checked"
                                Unchecked="FillOptionCheckBox_Checked" />
                        </Viewbox>
                    </Grid>
                    <!--  도형 선택 버튼들  -->
                    <UniformGrid
                        x:Name="ShapesPanel"
                        Margin="0,8"
                        VerticalAlignment="Center"
                        Columns="3">
                        <ui:Button
                            x:Name="RectangleBtn"
                            Margin="4"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0"
                            Click="ShapeBtn_Click"
                            Tag="Rectangle">
                            <Image
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Resources/icon_tools_rect_white.png" />
                            <Button.Effect>
                                <DropShadowEffect ShadowDepth="2" />
                            </Button.Effect>
                        </ui:Button>
                        <ui:Button
                            x:Name="EllipseBtn"
                            Margin="4"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0"
                            Click="ShapeBtn_Click"
                            Tag="Ellipse">
                            <Image
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Resources/icon_tools_circle_white.png" />
                            <Button.Effect>
                                <DropShadowEffect ShadowDepth="2" />
                            </Button.Effect>
                        </ui:Button>
                        <ui:Button
                            x:Name="TriangleBtn"
                            Margin="4"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0"
                            Click="ShapeBtn_Click"
                            Tag="Triangle">
                            <Image
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Resources/icon_tools_triangle_white.png" />
                            <Button.Effect>
                                <DropShadowEffect ShadowDepth="2" />
                            </Button.Effect>
                        </ui:Button>
                        <ui:Button
                            x:Name="LineBtn"
                            Margin="4,2"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0"
                            Click="ShapeBtn_Click"
                            Tag="Line">
                            <Image
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Resources/icon_tools_line_white.png" />
                            <Button.Effect>
                                <DropShadowEffect ShadowDepth="2" />
                            </Button.Effect>
                        </ui:Button>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Popup>

        <Popup
            x:Name="ThicknessPickerPopup"
            AllowsTransparency="True"
            HorizontalOffset="100"
            Placement="Center"
            PlacementTarget="{Binding ElementName=ThicknessBtn}"
            PopupAnimation="Fade"
            StaysOpen="False"
            VerticalOffset="0">
            <controls:QIThicknessPicker x:Name="ThicknessPicker" ThicknessChanged="ThicknessPicker_ThicknessChanged" />
        </Popup>

        <Popup
            x:Name="ColorPickerPopup"
            AllowsTransparency="True"
            HorizontalOffset="0"
            Placement="Center"
            PlacementTarget="{Binding ElementName=ColorPickerBtn}"
            StaysOpen="False"
            VerticalOffset="130">
            <controls:QIColorPicker x:Name="ColorPicker" SelectedColorChanged="ColorPicker_SelectedColorChanged" />
        </Popup>

        <Popup
            x:Name="DrawingToolPickerPopup"
            AllowsTransparency="True"
            HorizontalOffset="0"
            Placement="Center"
            PlacementTarget="{Binding ElementName=DrawingToolPickerBtn}"
            StaysOpen="False"
            VerticalOffset="-60">

            <controls:QIDrawingToolPicker x:Name="DrawingToolPicker" SelectedToolChanged="DrawingToolPicker_SelectedToolChanged" />
        </Popup>
    </Grid>
</UserControl>
