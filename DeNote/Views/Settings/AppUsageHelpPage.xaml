<UserControl
    x:Class="DeNote.Views.Settings.AppUsageHelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeNote.Views.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:DeNote.Resources"
    xmlns:settings="clr-namespace:DeNote.ViewModels.Settings"
    d:DataContext="{d:DesignInstance Type=settings:AppUsageHelpViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <StackPanel Orientation="Vertical">
            <StackPanel Margin="10,0">
                <TextBlock Margin="0,10" Text="{x:Static resources:HelpMessages.SelectDrawingTool_Title}" />
                <TextBlock
                    Margin="10"
                    FontSize="12"
                    Text="{x:Static resources:HelpMessages.SelectDrawingTool}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Margin="10,0">
                <TextBlock Margin="0,10" Text="{x:Static resources:HelpMessages.ExitApp_Title}" />
                <TextBlock
                    Margin="10"
                    FontSize="12"
                    Text="{x:Static resources:HelpMessages.ExitApp}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Margin="10,0">
                <TextBlock Margin="0,10" Text="{x:Static resources:HelpMessages.HelpCenterLink_Title}" />
                <TextBlock
                    Margin="10"
                    FontSize="12"
                    Text="{x:Static resources:HelpMessages.HelpCenterLink}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
