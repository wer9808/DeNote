<UserControl
    x:Class="DeNote.Views.Settings.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeNote.Views.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBlock Margin="10" Text="단축키" />
            <StackPanel Margin="10,0" Orientation="Horizontal">
                <TextBlock Margin="10" Text="프로그램 종료" />
                <TextBlock Margin="10" Text="Ctrl+Q" />
            </StackPanel>
            <StackPanel Margin="10,0" Orientation="Horizontal">
                <TextBlock Margin="10" Text="창 숨기기/보이기" />
                <TextBlock Margin="10" Text="Ctrl+Shift+F" />
            </StackPanel>
            <StackPanel Margin="10,0" Orientation="Horizontal">
                <TextBlock Margin="10" Text="초기화" />
                <TextBlock Margin="10" Text="F5" />
            </StackPanel>
            <StackPanel Margin="10,0" Orientation="Horizontal">
                <TextBlock Margin="10" Text="배경 새로고침" />
                <TextBlock Margin="10" Text="F6" />
            </StackPanel>
            <StackPanel Margin="10,0" Orientation="Horizontal">
                <TextBlock Margin="10" Text="배경 끄기/켜기" />
                <TextBlock Margin="10" Text="F7" />
            </StackPanel>
            <StackPanel Margin="10,0" Orientation="Horizontal">
                <TextBlock Margin="10" Text="스크린샷 촬영" />
                <TextBlock Margin="10" Text="PrintScreen" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
