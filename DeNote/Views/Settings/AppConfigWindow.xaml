<Window
    x:Class="DeNote.Views.Settings.AppConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeNote.Views.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="설정"
    Width="600"
    Height="450"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="일반">
                <local:GeneralSettingsPage />
            </TabItem>
            <TabItem Header="경로">
                <local:FilePathSettingsPage />
            </TabItem>
            <TabItem Header="도움말">
                <local:AppUsageHelpPage />
            </TabItem>
        </TabControl>

        <StackPanel
            Grid.Row="1"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                Width="80"
                Margin="0,0,10,0"
                Click="Save_Click"
                Content="저장" />
            <Button
                Width="80"
                Click="Cancel_Click"
                Content="취소" />
        </StackPanel>
    </Grid>
</Window>
