<UserControl
    x:Class="DeNote.Views.Settings.FilePathSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeNote.Views.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBlock Margin="10" Text="저장 경로" />
            <StackPanel Margin="10,0" Orientation="Horizontal">
                <TextBlock Margin="10" Text="동영상" />
                <TextBlock Margin="10" Text="{Binding VideoSavePath}" />
            </StackPanel>
            <StackPanel Margin="10,0" Orientation="Horizontal">
                <TextBlock Margin="10" Text="스크린샷" />
                <TextBlock Margin="10" Text="{Binding ImageSavePath}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
