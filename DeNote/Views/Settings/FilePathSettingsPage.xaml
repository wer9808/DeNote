<UserControl x:Class="DeNote.Views.Settings.FilePathSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DeNote.Views.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBlock Text="저장 경로" />
            <StackPanel Margin="10">
                <TextBlock Text="녹화 영상" />
                <TextBlock Text="{Binding VideoSavePath}" />
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock Text="스크린샷" />
                <TextBlock Text="{Binding ImageSavePath}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
