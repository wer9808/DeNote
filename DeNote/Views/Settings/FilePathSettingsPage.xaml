<UserControl
    x:Class="DeNote.Views.Settings.FilePathSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeNote.Views.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBlock Margin="10" Text="저장 경로" />
            <TextBlock
                Width="80"
                Margin="20,10,0,0"
                HorizontalAlignment="Left"
                FontSize="12"
                Text="동영상" />
            <StackPanel
                Margin="10,0"
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                <TextBox
                    Width="280"
                    Margin="10"
                    IsReadOnly="True"
                    Text="{Binding VideoSavePath}" />
                <ui:Button
                    Width="60"
                    Margin="4,0"
                    Command="{Binding ChangeVideoSavePathCommand}"
                    Content="변경" />
            </StackPanel>
            <TextBlock
                Width="80"
                Margin="20,10,0,0"
                HorizontalAlignment="Left"
                FontSize="12"
                Text="스크린샷" />
            <StackPanel
                Margin="10,0"
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                <TextBox
                    Width="280"
                    Margin="10"
                    IsReadOnly="True"
                    Text="{Binding ImageSavePath}" />
                <ui:Button
                    Width="60"
                    Margin="4,0"
                    Command="{Binding ChangeImageSavePathCommand}"
                    Content="변경" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
