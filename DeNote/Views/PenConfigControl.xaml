<UserControl x:Class="DeNote.Views.PenConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DeNote.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DeNote.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="vm:DrawingViewModel"
             d:DesignHeight="450">
    <StackPanel>
        <ui:Button x:Name="ThicknessUpBtn" Content="+" HorizontalAlignment="Center"  Margin="10,5"/>
        <ui:TextBox x:Name="ThicknessTextBox" Text="10" HorizontalAlignment="Center"  Margin="10,0"/>
        <ui:Button x:Name="ThicknessDownBtn" Content="-" HorizontalAlignment="Center"  Margin="10,5"/>
    </StackPanel>
</UserControl>
