<UserControl
    x:Class="DeNote.Views.QIDrawingCanvasControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeNote.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <local:QIDrawingCanvasView x:Name="DrawingCanvasView" Panel.ZIndex="0" />
        <local:QIDrawingToolbar x:Name="DrawingCanvasToolbar" Panel.ZIndex="10" />
        <TextBlock
            Margin="20,10"
            IsHitTestVisible="False"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Panel.ZIndex="1"
            Background="Transparent"
            FontSize="24"
            Foreground="White"
            Opacity="0.5"
            Text="De:Note" />
    </Grid>
</UserControl>
