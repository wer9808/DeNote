<UserControl
    x:Class="DeNote.Views.QIDrawingCanvasMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeNote.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Border
            x:Name="ToolbarContainer"
            Background="#50443F"
            BorderBrush="#AAFFFFFF"
            BorderThickness="0.2"
            CornerRadius="16"
                Margin="10"
            Opacity="0.9">
            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Separator Opacity="0.2" />
                <ui:Button
                    x:Name="UndoBtn"
                    Margin="10"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="UndoBtn_Click"
                    CornerRadius="30"
                    Foreground="#C0FFFFFF"
                    MouseOverBackground="Orange">
                    <TextBlock
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="↩"
                        TextAlignment="Center" />
                </ui:Button>
                <ui:Button
                    x:Name="RedoBtn"
                    Margin="10"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="RedoBtn_Click"
                    CornerRadius="30"
                    Foreground="#C0FFFFFF"
                    MouseOverBackground="Orange">
                    <TextBlock
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="↪"
                        TextAlignment="Center" />
                </ui:Button>
                <ui:Button
                        x:Name="ClearDrawingBtn"
                        Margin="10"
                        Padding="10"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="ClearDrawingBtn_Click"
                        CornerRadius="30"
                        Foreground="#C0FFFFFF"
                        MouseOverBackground="Orange">
                    <TextBlock
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="✨"
                            TextAlignment="Center" />
                </ui:Button>
                <Separator Opacity="0.5" />
                <ui:Button
                    x:Name="RecordBtn"
                    Margin="10"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="RecordBtn_Click"
                    CornerRadius="30"
                    Foreground="#C0FFFFFF"
                    MouseOverBackground="Orange">
                    <TextBlock
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="🎦"
                        TextAlignment="Center" />
                </ui:Button>
                <ui:Button
                    x:Name="SaveBtn"
                    Margin="10"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="SaveBtn_Click"
                    CornerRadius="30"
                    Foreground="#C0FFFFFF"
                    MouseOverBackground="Orange">
                    <TextBlock
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="📸"
                        TextAlignment="Center" />
                </ui:Button>
                <ui:Button
                    x:Name="ToggleBackgroundBtn"
                    Margin="10"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="ToggleBackgroundBtn_Click"
                    CornerRadius="30"
                    Foreground="#C0FFFFFF"
                    MouseOverBackground="Orange">
                    <TextBlock
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="🖼️"
                        TextAlignment="Center" />
                </ui:Button>
                <ui:Button
                    x:Name="SettingBtn"
                    Margin="10"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="SettingBtn_Click"
                    CornerRadius="30"
                    Foreground="#C0FFFFFF"
                    MouseOverBackground="Orange">
                    <TextBlock
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="ℹ️"
                        TextAlignment="Center" />
                </ui:Button>
                <Separator Opacity="0.5" />
                <ui:Button
                    x:Name="CloseBtn"
                    Margin="10"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="CloseBtn_Click"
                    CornerRadius="30"
                    Foreground="#C0FFFFFF"
                    MouseOverBackground="Orange">
                    <TextBlock
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="❌"
                        TextAlignment="Center" />
                </ui:Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
