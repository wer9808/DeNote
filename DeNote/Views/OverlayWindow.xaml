<Window x:Class="DeNote.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeNote.Views"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        IsHitTestVisible="True"
        ResizeMode="NoResize"
        Focusable="False"
        Title="OverlayWindow">
    <Canvas x:Name="DrawingCanvas" 
            IsHitTestVisible="True"
            Background="#01FFFFFF"
                MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown"
                MouseMove="DrawingCanvas_MouseMove"
                MouseLeftButtonUp="DrawingCanvas_MouseLeftButtonUp"
                StylusDown="DrawingCanvas_StylusDown"
                StylusMove="DrawingCanvas_StylusMove"
                StylusUp="DrawingCanvas_StylusUp"
                />
</Window>
