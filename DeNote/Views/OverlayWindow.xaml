<Window x:Class="DeNote.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeNote.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="None"
        IsHitTestVisible="True"
        ResizeMode="NoResize"
        Focusable="False"
        Title="OverlayWindow">
    <Grid>
        <skia:SKGLElement x:Name="DrawingCanvas" 
                          IsHitTestVisible="True"
                          PaintSurface="DrawingCanvas_PaintSurface"
                          MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown"
                          MouseMove="DrawingCanvas_MouseMove"
                          MouseLeftButtonUp="DrawingCanvas_MouseLeftButtonUp"
                          TouchDown="DrawingCanvas_TouchDown"
                          TouchMove="DrawingCanvas_TouchMove"
                          TouchUp="DrawingCanvas_TouchUp"
                          StylusDown="DrawingCanvas_StylusDown"
                          StylusMove="DrawingCanvas_StylusMove"
                          StylusUp="DrawingCanvas_StylusUp"/>
        <Border Visibility="{Binding ToolBarVisibility}"
                BorderBrush="#AAFFFFFF" BorderThickness="0.5" CornerRadius="36" 
                Background="#50443F" Opacity="0.9"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="10">
            <ToolBarTray x:Name="DrawingToolbar"
                         Background="Transparent"
                      Margin="10,0">
                <ToolBar ToolBarTray.IsLocked="True" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <TextBlock Text="De:Note" FontSize="20" Foreground="White" Margin="10,0" VerticalAlignment="Center"/>
                    <Separator Opacity="0.2" />
                    <StackPanel x:Name="DrawingToolPanel" Orientation="Horizontal">
                        <ui:Button x:Name="PenBtn" Click="PenBtn_Click" 
                                   BorderBrush="Transparent" Background="Transparent" MouseOverBackground="Orange" Foreground="#C0FFFFFF"
                                   HorizontalAlignment="Stretch" CornerRadius="30" Margin="10" Padding="10">
                            <!-- Pen -->
                            <TextBlock Text="✏️" Width="20" Height="20" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ui:Button>
                        <ui:Button x:Name="HighlighterBtn" Click="HighlighterBtn_Click" 
                                   BorderBrush="Transparent" Background="Transparent" MouseOverBackground="Orange" Foreground="#C0FFFFFF"
                                   HorizontalAlignment="Stretch" CornerRadius="30" Margin="10" Padding="10">
                            <!-- Pen -->
                            <TextBlock Text="🖍️" Width="20" Height="20" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ui:Button>
                        <ui:Button x:Name="ShapeBtn" Click="ShapeBtn_Click"  
                                   BorderBrush="Transparent" Background="Transparent" MouseOverBackground="Orange" Foreground="#C0FFFFFF"
                                   HorizontalAlignment="Stretch" CornerRadius="30" Margin="10" Padding="10">
                            <TextBlock Text="🔶" Width="20" Height="20" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ui:Button>
                    </StackPanel>
                    <Separator Opacity="0.2" />
                    <ui:Button x:Name="ClearDrawingBtn" Click="ClearDrawingBtn_Click" HorizontalAlignment="Stretch" 
                               BorderBrush="Transparent" Background="Transparent" MouseOverBackground="Orange" Foreground="#C0FFFFFF"
                           CornerRadius="30" Margin="10" Padding="10">
                        <TextBlock Text="❇️" Width="20" Height="20" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ui:Button>
                    <ui:Button x:Name="UndoBtn" Click="UndoBtn_Click" 
                               BorderBrush="Transparent" Background="Transparent" MouseOverBackground="Orange" Foreground="#C0FFFFFF"
                               HorizontalAlignment="Stretch" CornerRadius="30" Margin="10" Padding="10">
                        <TextBlock Text="↩" Width="20" Height="20" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ui:Button>
                    <ui:Button x:Name="RedoBtn" Click="RedoBtn_Click" 
                               BorderBrush="Transparent" Background="Transparent" MouseOverBackground="Orange" Foreground="#C0FFFFFF"
                               HorizontalAlignment="Stretch" CornerRadius="30" Margin="10" Padding="10">
                        <TextBlock Text="↪" Width="20" Height="20" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ui:Button>
                    <Separator Opacity="0.2" />
                    <local:DrawingAttributeControl DataContext="{Binding}" />
                    <Separator Opacity="0.2" />
                    <ui:Button x:Name="RecordBtn" Click="RecordBtn_Click" 
                               BorderBrush="Transparent" Background="Transparent" MouseOverBackground="Orange" Foreground="#C0FFFFFF"
                               HorizontalAlignment="Stretch" CornerRadius="30" Margin="10" Padding="10">
                        <TextBlock Text="🎦" Width="20" Height="20" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ui:Button>
                    <ui:Button x:Name="SaveBtn" Click="SaveBtn_Click" 
                               BorderBrush="Transparent" Background="Transparent" MouseOverBackground="Orange" Foreground="#C0FFFFFF"
                               HorizontalAlignment="Stretch" CornerRadius="30" Margin="10" Padding="10">
                        <TextBlock Text="📸" Width="20" Height="20" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ui:Button>
                    <ui:Button x:Name="CloseBtn" Click="CloseBtn_Click" Background="IndianRed" Foreground="#C0FFFFFF" 
                               HorizontalAlignment="Stretch" CornerRadius="30" Margin="10" Padding="10">
                        <TextBlock Text="❌" Width="20" Height="20" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ui:Button>
                </ToolBar>
            </ToolBarTray>
        </Border>
        
        <tray:NotifyIcon>
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="열기" Click="NotifyIcon_Show" />
                    <MenuItem Header="종료" Click="NotifyIcon_Exit" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</Window>
